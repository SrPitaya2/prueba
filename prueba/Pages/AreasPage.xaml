<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="prueba.Pages.AreasPage"
             Title="Areas">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label x:Name="EstablecimientoLabel" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Gestiona las areas de tu establecimiento" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="AreasContainer" Spacing="10"/>
        </ScrollView>
        <Button Grid.Row="2" Text="+ Agregar Area" Clicked="OnAgregarAreaClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="18" HeightRequest="50" Margin="0,20,0,0"/>
    </Grid>
</ContentPage>
