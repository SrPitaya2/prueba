<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="prueba.Pages.ConfiguracionPage"
             Title="Configuracion">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Start">
            <Label x:Name="TituloLabel" Text="Bienvenido a Inventarios" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label x:Name="SubtituloLabel" Text="Configura tu establecimiento" FontSize="18" HorizontalOptions="Center" TextColor="Gray"/>
            
            <Frame BorderColor="{StaticResource Primary}" CornerRadius="10" Padding="20" Margin="0,20,0,0" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Nombre del Establecimiento" FontSize="16" FontAttributes="Bold"/>
                    <Entry x:Name="NombreEntry" Placeholder="Ej: Mi Tienda, Almacen Central..." FontSize="18"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="{StaticResource Primary}" CornerRadius="10" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Logo del Establecimiento (PNG)" FontSize="16" FontAttributes="Bold"/>
                    <Image x:Name="LogoPreview" HeightRequest="150" Aspect="AspectFit" Margin="0,10"/>
                    <Button Text="Seleccionar Logo PNG" Clicked="OnSeleccionarLogoClicked" 
                            BackgroundColor="Transparent" BorderColor="{StaticResource Primary}" 
                            BorderWidth="1" TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <Button x:Name="GuardarBtn" Text="Comenzar" Clicked="OnGuardarClicked" 
                    BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="20" 
                    HeightRequest="60" Margin="0,20,0,20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>