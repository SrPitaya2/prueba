<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="prueba.Pages.PerfilPage"
             Title="Mi Perfil">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Crear/Editar Tu Perfil"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Frame BorderColor="{StaticResource Primary}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="Nombre" FontSize="16" FontAttributes="Bold"/>
                    <Entry x:Name="NombreEntry" 
                           Placeholder="Ingresa tu nombre"
                           Text="{Binding Nombre}"/>

                    <Label Text="Apellido" FontSize="16" FontAttributes="Bold"/>
                    <Entry x:Name="ApellidoEntry" 
                           Placeholder="Ingresa tu apellido"
                           Text="{Binding Apellido}"/>

                    <Label Text="Email" FontSize="16" FontAttributes="Bold"/>
                    <Entry x:Name="EmailEntry" 
                           Placeholder="tu@email.com"
                           Keyboard="Email"
                           Text="{Binding Email}"/>

                    <Label Text="Telefono" FontSize="16" FontAttributes="Bold"/>
                    <Entry x:Name="TelefonoEntry" 
                           Placeholder="+52 123 456 7890"
                           Keyboard="Telephone"
                           Text="{Binding Telefono}"/>

                </VerticalStackLayout>
            </Frame>

            <Button x:Name="GuardarBtn"
                    Text="Guardar Perfil"
                    Clicked="OnGuardarClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="18"
                    Margin="0,10,0,0"
                    HeightRequest="50"/>

            <Label x:Name="MensajeLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"/>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
