<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="prueba.Pages.ProductosPage" Title="Productos"><Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20"><VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,10"><Label x:Name="AreaLabel" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/><Label x:Name="EstadisticasLabel" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/></VerticalStackLayout><Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,15"><SearchBar x:Name="BusquedaBar" Placeholder="Buscar producto..." TextChanged="OnBusquedaTextChanged" Grid.Column="0"/><Button Text="🕒" Padding="0" Clicked="OnHistorialClicked" BackgroundColor="{StaticResource Secondary}" TextColor="White" WidthRequest="60" FontSize="24" FontAttributes="Bold" Grid.Column="1" Margin="10,0,0,0"/></Grid><ScrollView Grid.Row="2"><VerticalStackLayout x:Name="ProductosContainer" Spacing="15"/></ScrollView><Button Grid.Row="3" Text="+ Agregar Producto" Clicked="OnAgregarProductoClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="18" HeightRequest="50" Margin="0,20,0,0"/></Grid></ContentPage>