<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="prueba.Pages.DetalleProductoPage"
             Title="Detalle">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Frame BorderColor="{StaticResource Primary}" CornerRadius="10" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Informacion General" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Nombre" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="NombreEntry" FontSize="16"/>
                    <Label Text="Categoria (opcional)" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="CategoriaEntry" Placeholder="Ej: Alimentos..." FontSize="16"/>
                    <Label Text="Unidad de Medida" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="UnidadMedidaEntry" Placeholder="Ej: Unidades, Kg, L..." FontSize="16"/>
                    <Label Text="Stock Minimo" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="StockMinimoEntry" Keyboard="Numeric" FontSize="16"/>
                    <Label Text="Notas" FontSize="14" FontAttributes="Bold"/>
                    <Editor x:Name="NotasEditor" Placeholder="Observaciones..." HeightRequest="100"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BorderColor="{StaticResource Secondary}" CornerRadius="10" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Stock Actual" FontSize="16" FontAttributes="Bold"/>
                    <Label x:Name="StockLabel" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="UnidadLabel" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>
                    <Label x:Name="UltimaActualizacionLabel" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Button Text="Guardar Cambios" Clicked="OnGuardarClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="18" HeightRequest="60"/>
            <Button Text="Ver Historial Completo" Clicked="OnHistorialClicked" BackgroundColor="{StaticResource Secondary}" TextColor="White" FontSize="18" HeightRequest="60"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
