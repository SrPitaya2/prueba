<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="prueba.Pages.ReportesPage"
        Title="Reportes">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="Generar Reportes"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10"/>
            <Label Text="Selecciona el tipo de reporte que deseas generar y compartir"
                    FontSize="14"
                    HorizontalOptions="Center"
                    TextColor="Gray"
                    Margin="0,0,0,20"/>
            <Frame BorderColor="{StaticResource Primary}"
                    CornerRadius="10"
                    Padding="20"
                    HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Inventario Actual"
                            FontSize="20"
                            FontAttributes="Bold"/>
                    <Label Text="Stock actual de todos los productos por area"
                            FontSize="14"
                            TextColor="Gray"/>
                    <Button Text="Generar y Compartir"
                            Clicked="OnInventarioActualClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BorderColor="Red"
                    CornerRadius="10"
                    Padding="20"
                    HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Productos con Stock Bajo"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Red"/>
                    <Label Text="Lista de productos que necesitan reabastecimiento"
                            FontSize="14"
                            TextColor="Gray"/>
                    <Button Text="Generar y Compartir"
                            Clicked="OnStockBajoClicked"
                            BackgroundColor="Red"
                            TextColor="White"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BorderColor="{StaticResource Secondary}"
                    CornerRadius="10"
                    Padding="20"
                    HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Historial de Movimientos"
                            FontSize="20"
                            FontAttributes="Bold"/>
                    <Label Text="Ultimos 30 dias de entradas y salidas"
                            FontSize="14"
                            TextColor="Gray"/>
                    <Button Text="Generar y Compartir"
                            Clicked="OnMovimientosClicked"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
            <Frame BorderColor="#4A90E2"
                    CornerRadius="10"
                    Padding="20"
                    HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reporte Completo"
                            FontSize="20"
                            FontAttributes="Bold"/>
                    <Label Text="Inventario + Stock Bajo + Movimientos recientes"
                            FontSize="14"
                            TextColor="Gray"/>
                    <Button Text="Generar y Compartir"
                            Clicked="OnReporteCompletoClicked"
                            BackgroundColor="#4A90E2"
                            TextColor="White"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>