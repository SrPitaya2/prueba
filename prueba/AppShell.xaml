<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="prueba.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:prueba"
    xmlns:pages="clr-namespace:prueba.Pages"
    Title="Inventarios">

    <TabBar>
        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main" />

        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate pages:DashboardPage}"
            Route="dashboard" />

        <ShellContent
            Title="Areas"
            ContentTemplate="{DataTemplate pages:AreasPage}"
            Route="areas" />

        <ShellContent
            Title="Mi Perfil"
            ContentTemplate="{DataTemplate pages:PerfilPage}"
            Route="perfil" />

        <ShellContent
            Title="Config"
            ContentTemplate="{DataTemplate pages:ConfiguracionPage}"
            Route="configuracion" />
    </TabBar>

</Shell>
